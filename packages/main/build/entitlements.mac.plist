<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Vaste keychain-groep zodat macOS de safeStorage-toegang
       stabiel aan FTJM Chat koppelt (minder herhaalde prompts) -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.ftjm.chat</string>
  </array>
</dict>
</plist>
